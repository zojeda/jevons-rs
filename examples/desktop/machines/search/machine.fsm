// A web search, its answer in the bubble, and the results opened on request. The task waits in
// `results` for what the user says next; after two quiet minutes it ends.
fsm Search {
    timer quiet = 120000 -> quiet

    [*] --> searching

    state searching: "Searching the web for what the user asked"
    state answering: "Answering from the search results, in the bubble"
    state results: "The answer is in the bubble; waiting for what the user says about it"
    state opening: "Opening one of the results in the browser"

    searching --> answering
    searching --> [*] : failed
    answering --> results
    answering --> [*] : failed

    results --> opening : said [the user wants one of the results opened]
    results --> searching : said [the user asks to search for something else]
    results --> [*] : said [the user is done with these results, or talks about something else]
    results --> [*] : quiet

    // Opening asks first: declined or failed, the results are still there.
    opening --> results
    opening --> results : denied
    opening --> results : failed
}
